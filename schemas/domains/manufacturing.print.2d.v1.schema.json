{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimp.dev/schemas/domains/manufacturing.print.2d.v1.schema.json",
  "title": "Domain Schema — manufacturing.print.2d.v1",
  "description": "Two-dimensional printing on paper, cardstock, vinyl, fabric, etc. Consumes a raster or vector file and produces one or more prints.",
  "type": "object",
  "required": ["paper_size", "copies"],
  "properties": {
    "paper_size": {
      "oneOf": [
        {"enum": ["A6", "A5", "A4", "A3", "A2", "A1", "A0", "LETTER", "LEGAL", "TABLOID"]},
        {
          "type": "object",
          "required": ["width_mm", "height_mm"],
          "properties": {
            "width_mm": {"type": "number", "exclusiveMinimum": 0},
            "height_mm": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": false
        }
      ]
    },
    "paper_stock": {
      "type": "string",
      "description": "Paper stock identifier. Common values: 'plain_80gsm', 'matte_200gsm', 'glossy_photo_260gsm', 'cardstock_350gsm', 'vinyl_adhesive', 'fabric_cotton'."
    },
    "dpi": {
      "type": "integer",
      "enum": [150, 200, 300, 600, 1200, 2400]
    },
    "color_mode": {"enum": ["RGB", "CMYK", "GRAY", "BW"]},
    "color_profile": {
      "type": "string",
      "description": "Optional ICC profile name or URL for color-critical work."
    },
    "duplex": {"enum": ["none", "long_edge", "short_edge"]},
    "copies": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "finishing": {
      "type": "array",
      "items": {
        "enum": ["trim_to_bleed", "fold_half", "fold_tri", "saddle_stitch", "perfect_bind", "laminate_matte", "laminate_glossy", "hole_punch_3ring"]
      }
    },
    "margin_mm": {
      "type": "object",
      "properties": {
        "top": {"type": "number", "minimum": 0},
        "bottom": {"type": "number", "minimum": 0},
        "left": {"type": "number", "minimum": 0},
        "right": {"type": "number", "minimum": 0}
      }
    },
    "scaling": {
      "enum": ["none", "fit", "fill", "percent"],
      "default": "fit"
    },
    "scale_percent": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "description": "Only meaningful when scaling == 'percent'."
    }
  },
  "additionalProperties": false
}
